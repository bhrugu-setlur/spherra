{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Local index public API quality qualification",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "kind",
    "timestamp",
    "git_commit",
    "dirty_worktree",
    "machine",
    "command",
    "source",
    "durability_mode",
    "corpus_name",
    "corpus_hash",
    "query_hash",
    "seed",
    "vector_count",
    "query_count",
    "training_rows",
    "k",
    "candidate_budget",
    "generation",
    "segment_count",
    "model",
    "index_current_blake3",
    "oracle_reference",
    "historical_reference",
    "queries_checked",
    "hits_checked",
    "equality_differences",
    "enclosure_failures",
    "recall_at_10",
    "query_results",
    "gate_eligible",
    "gate_passed",
    "elapsed_seconds",
    "build_source_commit",
    "build_dirty_worktree",
    "reused_index"
  ],
  "properties": {
    "schema_version": {
      "enum": [
        1
      ]
    },
    "kind": {
      "enum": [
        "index"
      ]
    },
    "timestamp": {
      "type": "string"
    },
    "git_commit": {
      "type": "string"
    },
    "dirty_worktree": {
      "type": "boolean"
    },
    "machine": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "os",
        "architecture",
        "cpu",
        "physical_memory_bytes",
        "rustc",
        "cargo_profile"
      ],
      "properties": {
        "os": {
          "type": "string"
        },
        "architecture": {
          "type": "string"
        },
        "cpu": {
          "type": "string"
        },
        "physical_memory_bytes": {
          "type": "integer",
          "minimum": 0
        },
        "rustc": {
          "type": "string"
        },
        "cargo_profile": {
          "type": "string"
        }
      }
    },
    "command": {
      "type": "string"
    },
    "source": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "kind",
            "descriptor"
          ],
          "properties": {
            "kind": {
              "enum": [
                "generated"
              ]
            },
            "descriptor": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "kind",
                "dimension",
                "vector_count"
              ],
              "properties": {
                "kind": {
                  "enum": [
                    "gaussian",
                    "correlated"
                  ]
                },
                "dimension": {
                  "enum": [
                    768
                  ]
                },
                "vector_count": {
                  "type": "integer",
                  "minimum": 1
                }
              }
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "kind",
            "descriptor"
          ],
          "properties": {
            "kind": {
              "enum": [
                "file-backed"
              ]
            },
            "descriptor": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "name",
                "path",
                "byte_len",
                "blake3",
                "row_count",
                "dimension",
                "normalization",
                "source_dataset_revision",
                "embedding_model_revision",
                "license"
              ],
              "properties": {
                "name": {
                  "type": "string"
                },
                "path": {
                  "type": "string"
                },
                "byte_len": {
                  "type": "integer",
                  "minimum": 0
                },
                "blake3": {
                  "type": "string"
                },
                "row_count": {
                  "type": "integer",
                  "minimum": 0
                },
                "dimension": {
                  "enum": [
                    768
                  ]
                },
                "normalization": {
                  "type": "string"
                },
                "source_dataset_revision": {
                  "type": "string"
                },
                "embedding_model_revision": {
                  "type": "string"
                },
                "license": {
                  "type": "string"
                }
              }
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "kind",
            "descriptor"
          ],
          "properties": {
            "kind": {
              "enum": [
                "chunked"
              ]
            },
            "descriptor": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "generator_version",
                "kind",
                "dimension",
                "vector_count",
                "chunk_rows",
                "seed",
                "correlation",
                "seed_derivation",
                "chunk_seeds"
              ],
              "properties": {
                "generator_version": {
                  "enum": [
                    1
                  ]
                },
                "kind": {
                  "enum": [
                    "correlated"
                  ]
                },
                "dimension": {
                  "enum": [
                    768
                  ]
                },
                "vector_count": {
                  "type": "integer",
                  "minimum": 1
                },
                "chunk_rows": {
                  "type": "integer",
                  "minimum": 1
                },
                "seed": {
                  "type": "integer",
                  "minimum": 0
                },
                "correlation": {
                  "enum": [
                    0.85
                  ]
                },
                "seed_derivation": {
                  "enum": [
                    "spherra.generated-correlated.chunks.v1"
                  ]
                },
                "chunk_seeds": {
                  "type": "array",
                  "minItems": 1,
                  "items": {
                    "type": "integer",
                    "minimum": 0
                  }
                }
              }
            }
          }
        }
      ]
    },
    "durability_mode": {
      "enum": [
        "file-and-directory-sync"
      ]
    },
    "corpus_name": {
      "type": "string"
    },
    "corpus_hash": {
      "type": "string"
    },
    "query_hash": {
      "type": "string"
    },
    "seed": {
      "type": "integer",
      "minimum": 0
    },
    "vector_count": {
      "type": "integer",
      "minimum": 10
    },
    "query_count": {
      "type": "integer",
      "minimum": 1
    },
    "training_rows": {
      "type": "integer",
      "minimum": 0
    },
    "k": {
      "enum": [
        10
      ]
    },
    "candidate_budget": {
      "type": "integer",
      "minimum": 10
    },
    "generation": {
      "type": "integer",
      "minimum": 1
    },
    "segment_count": {
      "type": "integer",
      "minimum": 1
    },
    "model": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "transform_id",
        "quantizer_id",
        "pq_codebook_id",
        "codec_id",
        "scorer_version",
        "layout"
      ],
      "properties": {
        "transform_id": {
          "type": "string"
        },
        "quantizer_id": {
          "type": "string"
        },
        "pq_codebook_id": {
          "type": "string"
        },
        "codec_id": {
          "type": "string"
        },
        "scorer_version": {
          "enum": [
            1
          ]
        },
        "layout": {
          "enum": [
            "tiled-soa-32"
          ]
        }
      }
    },
    "index_current_blake3": {
      "type": "string"
    },
    "oracle_reference": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "report_path",
        "report_blake3",
        "rankings_blake3",
        "git_commit",
        "dirty_worktree"
      ],
      "properties": {
        "kind": {
          "enum": [
            "fresh-streaming",
            "pinned"
          ]
        },
        "report_path": {
          "oneOf": [
            {
              "type": "null"
            },
            {
              "type": "string"
            }
          ]
        },
        "report_blake3": {
          "oneOf": [
            {
              "type": "null"
            },
            {
              "type": "string"
            }
          ]
        },
        "rankings_blake3": {
          "type": "string"
        },
        "git_commit": {
          "type": "string"
        },
        "dirty_worktree": {
          "type": "boolean"
        }
      }
    },
    "historical_reference": {
      "oneOf": [
        {
          "type": "null"
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "report_path",
            "report_blake3",
            "git_commit",
            "dirty_worktree",
            "recall_at_10",
            "matching_hits",
            "hits_total",
            "drop",
            "gate_passed"
          ],
          "properties": {
            "report_path": {
              "type": "string"
            },
            "report_blake3": {
              "type": "string"
            },
            "git_commit": {
              "type": "string"
            },
            "dirty_worktree": {
              "type": "boolean"
            },
            "recall_at_10": {
              "type": "number"
            },
            "matching_hits": {
              "type": "integer",
              "minimum": 0
            },
            "hits_total": {
              "type": "integer",
              "minimum": 0
            },
            "drop": {
              "type": "number"
            },
            "gate_passed": {
              "type": "boolean"
            }
          }
        }
      ]
    },
    "queries_checked": {
      "type": "integer",
      "minimum": 0
    },
    "hits_checked": {
      "type": "integer",
      "minimum": 0
    },
    "equality_differences": {
      "type": "integer",
      "minimum": 0
    },
    "enclosure_failures": {
      "type": "integer",
      "minimum": 0
    },
    "recall_at_10": {
      "type": "number"
    },
    "query_results": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "query",
          "exact_matches",
          "hits"
        ],
        "properties": {
          "query": {
            "type": "integer",
            "minimum": 0
          },
          "exact_matches": {
            "type": "integer",
            "minimum": 0
          },
          "hits": {
            "type": "array",
            "minItems": 10,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "row",
                "raw",
                "expected_row",
                "expected_raw",
                "score",
                "lower",
                "upper",
                "truth"
              ],
              "properties": {
                "row": {
                  "type": "integer",
                  "minimum": 0
                },
                "raw": {
                  "type": "integer"
                },
                "expected_row": {
                  "type": "integer",
                  "minimum": 0
                },
                "expected_raw": {
                  "type": "integer"
                },
                "score": {
                  "type": "number"
                },
                "lower": {
                  "type": "number"
                },
                "upper": {
                  "type": "number"
                },
                "truth": {
                  "type": "number"
                }
              }
            }
          }
        }
      }
    },
    "gate_eligible": {
      "type": "boolean"
    },
    "gate_passed": {
      "type": "boolean"
    },
    "elapsed_seconds": {
      "type": "number",
      "minimum": 0
    },
    "build_source_commit": {
      "type": "string"
    },
    "build_dirty_worktree": {
      "type": "boolean"
    },
    "reused_index": {
      "type": "boolean"
    }
  }
}
